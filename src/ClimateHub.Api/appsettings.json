{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=climate_hub;Username=climate_hub;Password=SET_VIA_ENVIRONMENT"
  },
  "Jwt": {
    "Issuer": "ClimateHub",
    "Audience": "ClimateHub.Api",
    "SigningKey": "SET_VIA_ENVIRONMENT_OR_USER_SECRETS_MIN_32_CHARS_LONG",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "climate-hub-api",
    "Username": "",
    "Password": "",
    "UseTls": false,
    "ReconnectBaseDelayMs": 1000,
    "ReconnectMaxDelayMs": 60000
  },
  "InfluxDb": {
    "Url": "http://localhost:8086",
    "Token": "SET_VIA_ENVIRONMENT",
    "Organization": "climate-hub",
    "Bucket": "climate-hub"
  }
}