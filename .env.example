# Climate Hub - Local Development Environment
# Copy this file to .env and adjust values as needed

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=climate_hub
POSTGRES_USER=climate_hub
POSTGRES_PASSWORD=CHANGE_ME

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PORT_WS=9001
MQTT_USERNAME=
MQTT_PASSWORD=

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=climate-hub
INFLUXDB_BUCKET=climate-hub

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=