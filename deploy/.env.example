# Climate Hub - Docker Compose Environment Example
# Copy to .env and adjust values

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=climate_hub
POSTGRES_USER=climate_hub
POSTGRES_PASSWORD=CHANGE_ME

# MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_PORT_WS=9001

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=climate-hub
INFLUXDB_BUCKET=climate-hub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379