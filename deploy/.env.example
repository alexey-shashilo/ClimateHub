# Climate Hub - Docker Compose Environment Example
# Copy to .env and adjust values before production deployment.
# All variables marked "required" have no safe default and MUST be set.

# ===== PostgreSQL =====
POSTGRES_DB=climate_hub
POSTGRES_USER=climate_hub
POSTGRES_PASSWORD=CHANGE_ME            # required

# ===== MQTT Broker =====
# Plain-text MQTT listener for the internal network (gateway/api <-> broker).
# The external device ingress uses TLS on 8883 (see mosquitto.prod.conf).
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Credentials used by API and Device Gateway to connect to the broker.
MQTT_API_USERNAME=climate-hub-api
MQTT_API_PASSWORD=CHANGE_ME            # required
MQTT_GATEWAY_USERNAME=climate-hub-gateway
MQTT_GATEWAY_PASSWORD=CHANGE_ME        # required

# Dedicated, least-privilege account used only by the broker healthcheck.
MQTT_MONITOR_USERNAME=climate-hub-healthcheck
MQTT_MONITOR_PASSWORD=CHANGE_ME        # required

# ===== InfluxDB =====
INFLUXDB_PASSWORD=CHANGE_ME            # required
INFLUXDB_TOKEN=CHANGE_ME               # required
INFLUXDB_ORG=climate-hub
INFLUXDB_BUCKET=climate-hub

# ===== JSON Web Tokens =====
JWT_ISSUER=climate-hub
JWT_AUDIENCE=climate-hub-api
JWT_SIGNING_KEY=CHANGE_ME_TO_32BYTES_OR_MORE # required (>=32 chars, high entropy)

# ===== Monitoring =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME       # required

# ===== Caddy / Reverse Proxy =====
# Public hostname the deployment is exposed under. When unset Caddy uses localhost:8080.
DOMAIN=localhost:8080
HTTP_PORT=80
HTTPS_PORT=443

# Image tag(s) used by the stack.
CLIMATE_HUB_VERSION=latest